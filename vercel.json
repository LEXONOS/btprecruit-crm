{
  "regions": [
    "cdg1"
  ],
  "functions": {
    "api/tick.js": {
      "maxDuration": 300,
      "includeFiles": "lib/sites/polices/**"
    },
    "api/hq.js": {
      "maxDuration": 60,
      "includeFiles": "lib/sites/polices/**"
    },
    "api/whatsapp.js": {
      "maxDuration": 240
    }
  },
  "crons": [
    {
      "path": "/api/tick",
      "schedule": "*/15 * * * *"
    },
    {
      "path": "/api/whatsapp",
      "schedule": "*/5 * * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ]
    }
  ]
}
