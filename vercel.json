{
  "outputDirectory": "public",
  "rewrites": [
    {
      "source": "/hub",
      "destination": "/hub.html"
    },
    {
      "source": "/crm",
      "destination": "/crm.html"
    },
    {
      "source": "/formation",
      "destination": "/formation.html"
    },
    {
      "source": "/annuaire",
      "destination": "/annuaire.html"
    },
    {
      "source": "/documents",
      "destination": "/documents.html"
    },
    {
      "source": "/statistiques",
      "destination": "/statistiques.html"
    },
    {
      "source": "/sign",
      "destination": "/sign.html"
    },
    {
      "source": "/dossier",
      "destination": "/dossier.html"
    },
    {
      "source": "/rejoindre",
      "destination": "/rejoindre.html"
    },
    {
      "source": "/sites-sign",
      "destination": "/sites-sign.html"
    },
    {
      "source": "/sites-cadrage",
      "destination": "/sites-cadrage.html"
    },
    {
      "source": "/sites",
      "destination": "/sites.html"
    },
    {
      "source": "/prospection",
      "destination": "/prospection.html"
    },
    {
      "source": "/sites-usine",
      "destination": "/sites-usine.html"
    }
  ],
  "headers": [
    {
      "source": "/api/(.*)",
      "headers": [
        {
          "key": "Access-Control-Allow-Origin",
          "value": "*"
        },
        {
          "key": "Access-Control-Allow-Methods",
          "value": "GET,POST,OPTIONS"
        },
        {
          "key": "Access-Control-Allow-Headers",
          "value": "Content-Type,X-CRM-Secret"
        }
      ]
    }
  ],
  "crons": [
    {
      "path": "/api/cron-reminders",
      "schedule": "0 7 * * 1-5"
    }
  ],
  "functions": {
    "api/usine.js": {
      "maxDuration": 300
    }
  }
}