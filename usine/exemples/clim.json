  "langues": {
    "fr": {
      "titre": "Ta clim ne fabrique pas de froid",
      "accroche": "Ta clim ne *fabrique* pas de froid.",
      "description": "Ta clim ne crée jamais de froid : elle déplace la chaleur de ta pièce vers l'extérieur, avec un fluide, un compresseur et une minuscule vanne. Toute la boucle en 3D.",
      "hashtags": [
        "#commentcamarche",
        "#ingenierie",
        "#climatisation",
        "#physique",
        "#3d"
      ],
      "beats": [
        {
          "voix": "Ta clim ne fabrique pas de froid. Elle déplace la chaleur de ta pièce vers l'extérieur."
        },
        {
          "voix": "Tout repose sur un seul fluide, le réfrigérant, qui tourne en boucle dans ces tuyaux de cuivre.",
          "etiquettes": [
            {
              "objet": "aspiration",
              "texte": "Réfrigérant"
            }
          ]
        },
        {
          "voix": "Étape un : le compresseur écrase le gaz. Un gaz comprimé chauffe, autour de quatre-vingts degrés.",
          "ecran": "80 °C",
          "etiquettes": [
            {
              "objet": "compresseur",
              "texte": "Compresseur"
            }
          ]
        },
        {
          "voix": "Ce gaz brûlant monte dans le serpentin de l'unité extérieure.",
          "etiquettes": [
            {
              "objet": "gaz_chaud",
              "texte": "Gaz chaud"
            }
          ]
        },
        {
          "voix": "Un ventilateur pousse l'air du dehors entre les ailettes et arrache la chaleur du gaz.",
          "etiquettes": [
            {
              "objet": "condenseur",
              "texte": "Condenseur"
            },
            {
              "objet": "air_chaud",
              "texte": "Chaleur évacuée"
            }
          ]
        },
        {
          "voix": "En refroidissant, le gaz redevient liquide, toujours sous haute pression.",
          "etiquettes": [
            {
              "objet": "liquide",
              "texte": "Liquide tiède"
            }
          ]
        },
        {
          "voix": "Puis vient l'astuce : une minuscule vanne. Le liquide s'y faufile, et sa pression s'effondre.",
          "etiquettes": [
            {
              "objet": "detendeur",
              "texte": "Détendeur"
            }
          ]
        },
        {
          "voix": "À basse pression, il bout dès cinq degrés. Et en bouillant, il absorbe la chaleur.",
          "ecran": "5 °C",
          "etiquettes": [
            {
              "objet": "gaz_froid",
              "texte": "Brouillard froid"
            }
          ]
        },
        {
          "voix": "Dedans, l'air chaud de ta pièce traverse ce serpentin glacé, et ressort tout froid.",
          "etiquettes": [
            {
              "objet": "evaporateur",
              "texte": "Évaporateur"
            },
            {
              "objet": "air_froid",
              "texte": "Air froid"
            }
          ]
        },
        {
          "voix": "Le gaz, chargé de la chaleur de ta pièce, repart vers le compresseur.",
          "etiquettes": [
            {
              "objet": "aspiration",
              "texte": "Retour au compresseur"
            }
          ]
        },
        {
          "voix": "Et la boucle recommence, toute la journée. Voilà pourquoi l'unité dehors souffle chaud : c'est la chaleur de ta pièce, jetée dehors."
        }
      ]
    }
  }
}